<Project>
  <PropertyGroup>
    <WorkersPublishDirectory Condition="'$(WorkersPublishDirectory)' == ''">$(WasmAppDir)</WorkersPublishDirectory>
    <WorkersPublishDirectory Condition="'$(WorkersPublishDirectory)' == ''">$(OutputPath)AppBundle\</WorkersPublishDirectory>
    <WorkersAssemblyPath Condition="'$(WorkersAssemblyPath)' == ''">$(TargetPath)</WorkersAssemblyPath>
    <WorkersOutputDirectory Condition="'$(WorkersOutputDirectory)' == ''">$(MSBuildProjectDirectory)\dist</WorkersOutputDirectory>
    <WorkersJavaScriptModule Condition="'$(WorkersJavaScriptModule)' == ''">worker.js</WorkersJavaScriptModule>
    <WorkersCompatibilityDate Condition="'$(WorkersCompatibilityDate)' == ''">2025-01-01</WorkersCompatibilityDate>
    <WorkersIncludePlatformApis Condition="'$(WorkersIncludePlatformApis)' == ''">true</WorkersIncludePlatformApis>
    <WorkersBuildAssembly Condition="'$(WorkersBuildAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Workers.dll')">$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Workers.dll</WorkersBuildAssembly>
    <WorkersBuildAssembly Condition="'$(WorkersBuildAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Workers.dll')">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Workers.dll</WorkersBuildAssembly>
  </PropertyGroup>

  <UsingTask
    TaskName="Workers.Build.PublishWorkerBundle"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
    Condition="'$(WorkersBuildAssembly)' != ''">
    <ParameterGroup>
      <PublishDirectory ParameterType="System.String" Required="true" />
      <AssemblyPath ParameterType="System.String" Required="true" />
      <BuildAssembly ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <JavaScriptModule ParameterType="System.String" Required="true" />
      <WorkerName ParameterType="System.String" Required="false" />
      <CompatibilityDate ParameterType="System.String" Required="true" />
      <IncludePlatformApis ParameterType="System.Boolean" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Reflection;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

namespace Workers.Build;

public sealed class PublishWorkerBundle : Task
{
    [Required]
    public string PublishDirectory { get; set; } = "";

    [Required]
    public string AssemblyPath { get; set; } = "";

    [Required]
    public string BuildAssembly { get; set; } = "";

    [Required]
    public string OutputDirectory { get; set; } = "";

    [Required]
    public string JavaScriptModule { get; set; } = "";

    public string WorkerName { get; set; } = "";

    [Required]
    public string CompatibilityDate { get; set; } = "";

    [Required]
    public bool IncludePlatformApis { get; set; } = true;

    public override bool Execute()
    {
        try
        {
            var workersAssembly = Assembly.LoadFrom(BuildAssembly);
            var optionsType = workersAssembly.GetType("Workers.Build.PublishBundleOptions", throwOnError: true);
            var writerType = workersAssembly.GetType("Workers.Build.PublishBundleWriter", throwOnError: true);
            var runtimeAdapterOptionsType = workersAssembly.GetType("Workers.Build.RuntimeAdapterOptions", throwOnError: true);
            var options = Activator.CreateInstance(optionsType, PublishDirectory, AssemblyPath, OutputDirectory);
            var runtimeAdapterOptions = Activator.CreateInstance(runtimeAdapterOptionsType);

            optionsType.GetProperty("JavaScriptModule").SetValue(options, JavaScriptModule);
            optionsType.GetProperty("Name").SetValue(options, string.IsNullOrWhiteSpace(WorkerName) ? null : WorkerName);
            optionsType.GetProperty("CompatibilityDate").SetValue(options, CompatibilityDate);
            runtimeAdapterOptionsType.GetProperty("IncludePlatformApis").SetValue(runtimeAdapterOptions, IncludePlatformApis);
            optionsType.GetProperty("RuntimeAdapterOptions").SetValue(options, runtimeAdapterOptions);

            var writeAsync = writerType.GetMethod("WriteAsync", new[] { optionsType, typeof(System.Threading.CancellationToken) });
            var task = (System.Threading.Tasks.Task)writeAsync.Invoke(null, new object[] { options, default(System.Threading.CancellationToken) });
            task.GetAwaiter().GetResult();
            Log.LogMessage(MessageImportance.High, "Workers bundle written to '{0}'.", OutputDirectory);
            return true;
        }
        catch (Exception exception)
        {
            Log.LogErrorFromException(exception, showStackTrace: true);
            return false;
        }
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target
    Name="WorkersPublishBundle"
    AfterTargets="_WasmGenerateAppBundle"
    Condition="'$(RuntimeIdentifier)' == 'browser-wasm' and '$(WorkersPublishBundle)' != 'false'">
    <Error
      Condition="'$(WorkersBuildAssembly)' == ''"
      Text="Workers could not find Workers.dll for bundling. Set WorkersBuildAssembly to the built Workers assembly path." />
    <PublishWorkerBundle
      PublishDirectory="$(WorkersPublishDirectory)"
      AssemblyPath="$(WorkersAssemblyPath)"
      BuildAssembly="$(WorkersBuildAssembly)"
      OutputDirectory="$(WorkersOutputDirectory)"
      JavaScriptModule="$(WorkersJavaScriptModule)"
      WorkerName="$(WorkersName)"
      CompatibilityDate="$(WorkersCompatibilityDate)"
      IncludePlatformApis="$(WorkersIncludePlatformApis)" />
  </Target>
</Project>
