<Project>
  <PropertyGroup>
    <ProvideCommandLineArgs>true</ProvideCommandLineArgs>
    <WorkerOutputPath Condition="'$(WorkerOutputPath)' == ''">$(MSBuildProjectDirectory)\dist\worker.js</WorkerOutputPath>
    <_WorkersOutputDirectory>$([System.IO.Path]::GetDirectoryName('$(WorkerOutputPath)'))</_WorkersOutputDirectory>
    <_WorkersApiAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Workers.dll')">$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Workers.dll</_WorkersApiAssembly>
    <_WorkersApiAssembly Condition="'$(_WorkersApiAssembly)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Workers.dll</_WorkersApiAssembly>
    <_WorkersCompilerPath Condition="Exists('$(MSBuildThisFileDirectory)..\tools\net10.0\Workers.Compiler.dll')">$(MSBuildThisFileDirectory)..\tools\net10.0\Workers.Compiler.dll</_WorkersCompilerPath>
    <_WorkersCompilerPath Condition="'$(_WorkersCompilerPath)' == ''">$(MSBuildThisFileDirectory)..\Compiler\bin\$(Configuration)\net10.0\Workers.Compiler.dll</_WorkersCompilerPath>
    <_WorkersDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_WorkersDotNetHost>
    <_WorkersDotNetHost Condition="'$(_WorkersDotNetHost)' == ''">dotnet</_WorkersDotNetHost>
  </PropertyGroup>

  <!-- Worker code runs on the Workers runtime, where these namespaces are unavailable; their type names
       (File, ExecutionContext, HttpMethod) would also collide with the Workers APIs. -->
  <Target Name="RemoveUnsupportedWorkerUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.IO;System.Net.Http;System.Threading" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveStaleWorkerArtifact" BeforeTargets="CoreCompile;Clean" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_WorkersCompilerArgumentsFile>$(IntermediateOutputPath)worker-compiler-arguments.rsp</_WorkersCompilerArgumentsFile>
    </PropertyGroup>
    <ItemGroup>
      <!-- Bootstrap the manifest even when upgrading an already compiled project. -->
      <CustomAdditionalCompileInputs Include="$(_WorkersCompilerArgumentsFile)"
                                     Condition="!Exists('$(_WorkersCompilerArgumentsFile)')" />
    </ItemGroup>
    <Delete Files="$(WorkerOutputPath)" />
  </Target>

  <Target Name="CompileWorker"
          AfterTargets="CoreCompile"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_WorkersCompileCommand>&quot;$(_WorkersDotNetHost)&quot; &quot;$(_WorkersCompilerPath)&quot; --project &quot;$(MSBuildProjectDirectory)&quot; --rsp &quot;$(_WorkersCompilerArgumentsFile)&quot; --output &quot;$(WorkerOutputPath)&quot;</_WorkersCompileCommand>
    </PropertyGroup>
    <Error Condition="'$(_WorkersCompilerPath)' == '' or !Exists('$(_WorkersCompilerPath)')"
           Text="The Workers compiler was not found. Build or restore the Workers package before compiling this project." />
    <Error Condition="'$(_WorkersApiAssembly)' == '' or !Exists('$(_WorkersApiAssembly)')"
           Text="The Workers API reference assembly was not found." />

    <MakeDir Directories="$(_WorkersOutputDirectory)" />
    <WriteLinesToFile File="$(_WorkersCompilerArgumentsFile)"
                      Lines="@(CscCommandLineArgs)"
                      Condition="'@(CscCommandLineArgs)' != ''"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Error Condition="!Exists('$(_WorkersCompilerArgumentsFile)')"
           Text="MSBuild did not provide C# compiler arguments for the Workers compilation." />
    <ItemGroup>
      <FileWrites Include="$(_WorkersCompilerArgumentsFile)" />
    </ItemGroup>
    <Exec Command="$(_WorkersCompileCommand)" />
    <Message Importance="High" Text="Worker module written to '$(WorkerOutputPath)'." />
  </Target>
</Project>
